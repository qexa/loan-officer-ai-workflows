{
  "$schema_version": "1.0",
  "fields": [
    {
      "key": "lead_source",
      "label": "Lead Source",
      "type": "dropdown",
      "group": "Lead",
      "options": [
        "Inbound Call",
        "Web Form",
        "Web Chat",
        "Realtor Referral",
        "Past Client Referral",
        "Zillow",
        "LendingTree",
        "Paid Ads",
        "Social",
        "Other"
      ]
    },
    {
      "key": "referral_partner",
      "label": "Referral Partner",
      "type": "text",
      "group": "Lead"
    },
    {
      "key": "loan_purpose",
      "label": "Loan Purpose",
      "type": "dropdown",
      "group": "Lead",
      "options": [
        "Purchase",
        "Rate/Term Refinance",
        "Cash-Out Refinance",
        "HELOC",
        "Other"
      ]
    },
    {
      "key": "occupancy",
      "label": "Occupancy",
      "type": "dropdown",
      "group": "Lead",
      "options": [
        "Primary",
        "Second Home",
        "Investment"
      ]
    },
    {
      "key": "property_type",
      "label": "Property Type",
      "type": "dropdown",
      "group": "Lead",
      "options": [
        "Single Family",
        "Condo",
        "Townhome",
        "2-4 Unit",
        "Manufactured",
        "Unknown"
      ]
    },
    {
      "key": "property_state",
      "label": "Property State",
      "type": "text",
      "group": "Lead"
    },
    {
      "key": "property_county",
      "label": "Property County",
      "type": "text",
      "group": "Lead"
    },
    {
      "key": "buying_timeframe",
      "label": "Buying Timeframe",
      "type": "dropdown",
      "group": "Timeline",
      "options": [
        "Under Contract",
        "0-30 Days",
        "30-90 Days",
        "90+ Days",
        "Just Curious",
        "N/A (Refinance)"
      ]
    },
    {
      "key": "contract_date",
      "label": "Contract Date",
      "type": "date",
      "group": "Timeline"
    },
    {
      "key": "closing_date",
      "label": "Closing Date",
      "type": "date",
      "group": "Timeline"
    },
    {
      "key": "lock_expiration_date",
      "label": "Rate Lock Expiration",
      "type": "date",
      "group": "Timeline"
    },
